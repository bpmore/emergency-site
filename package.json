{
  "name": "emergency-site",
  "version": "1.0.0",
  "description": "A boilerplate for emergency information websites",
  "scripts": {
    "build": "eleventy",
    "watch": "eleventy --watch",
    "serve": "eleventy --serve",
    "debug": "DEBUG=* eleventy",
    "start": "npm run serve",
    "test": "node --test tests/*.test.cjs && python3 scripts/check-build.py"
  },
  "repository": {
    "type": "git",
