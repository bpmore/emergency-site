  },
  "author": "Max B\u00f6ck",
  "license": "MIT",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "clean-css": "^4.2.3",
    "dotenv": "^8.2.0",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "html-minifier-terser": "^7.2.0",
    "workbox-build": "^7.4.1"
  },
  "engines": {
    "node": "22.x"
  }
}
